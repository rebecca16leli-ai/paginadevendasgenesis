# Cadastre estas variáveis na Vercel: Settings → Environment Variables

# Obrigatória — Mercado Pago → Suas integrações → (sua aplicação) → Credenciais de produção → Access Token
MP_ACCESS_TOKEN=APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000

# Obrigatória — endereço público do site, sem barra no final
SITE_URL=https://catalogo.genesisprotection.com.br

# Opcional — planilha de pedidos (ver planilha/apps-script.js)
PLANILHA_URL=
PLANILHA_SEGREDO=
